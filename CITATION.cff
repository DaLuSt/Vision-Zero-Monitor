    given-names: Daan
version: 1.0.0
date-released: "2026-10-17"
license: MIT
repository-code: "https://github.com/DaLuSt/Vision-Zero-Monitor"
url: "https://dalust.github.io/Vision-Zero-Monitor/"
keywords:
  - road safety
  - Vision Zero
  - European Union
  - Eurostat
  - open data
  - traffic fatalities
