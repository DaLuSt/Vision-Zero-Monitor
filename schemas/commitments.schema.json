{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commitments.schema.json",
  "title": "Policy commitments with outcomes from official statistics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "reviewed_at",
    "review_note",
    "statistics_source",
    "summary",
    "commitments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_note": {
      "type": "string"
    },
    "statistics_source": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitments",
        "targets",
        "targets_measured"
      ],
      "properties": {
        "commitments": {
          "type": "integer",
          "minimum": 0
        },
        "targets": {
          "type": "integer",
          "minimum": 0
        },
        "targets_measured": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "issuer",
          "level",
          "scope",
          "form",
          "nature",
          "date",
          "sources",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "issuer": {
            "type": "string",
            "minLength": 3
          },
          "level": {
            "enum": [
              "eu",
              "global",
              "national"
            ]
          },
          "scope": {
            "type": "string"
          },
          "form": {
            "enum": [
              "commission_policy",
              "council_conclusions",
              "ministerial_declaration",
              "un_resolution",
              "national_strategy"
            ]
          },
          "nature": {
            "type": "string",
            "minLength": 20
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "title",
                "reference",
                "publisher",
                "date",
                "url",
                "location",
                "quote"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "primary",
                    "first_set_out",
                    "reaffirmed"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 5
                },
                "reference": {
                  "type": "string",
                  "minLength": 3
                },
                "publisher": {
                  "type": "string",
                  "minLength": 3
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "location": {
                  "type": "string",
                  "minLength": 3
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 700
                }
              }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "indicator",
                "description",
                "reduction",
                "baseline_year",
                "target_year",
                "measure",
                "not_measured_reason",
                "scope_note",
                "monitoring_baselines",
                "outcomes",
                "reference"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "indicator": {
                  "enum": [
                    "road_deaths",
                    "serious_injuries"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 5
                },
                "reduction": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "baseline_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1990
                },
                "target_year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "measure": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "geo",
                        "indicator"
                      ],
                      "properties": {
                        "geo": {
                          "type": "string"
                        },
                        "indicator": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "not_measured_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "monitoring_baselines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "year",
                      "note",
                      "source"
                    ],
                    "properties": {
                      "year": {
                        "type": "integer",
                        "minimum": 1990
                      },
                      "note": {
                        "type": "string",
                        "minLength": 20
                      },
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "title",
                          "publisher",
                          "url"
                        ],
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "publisher": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https://"
                          }
                        }
                      }
                    }
                  }
                },
                "outcomes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "basis",
                      "baseline_year",
                      "baseline_value",
                      "baseline_status",
                      "target_year",
                      "target_value",
                      "required_change_pct",
                      "compare_year",
                      "compare_value",
                      "compare_status",
                      "deadline_passed",
                      "change_pct",
                      "share_of_required_reduction",
                      "above_target_value"
                    ],
                    "properties": {
                      "basis": {
                        "enum": [
                          "as_stated",
                          "commission_monitoring"
                        ]
                      },
                      "baseline_year": {
                        "type": "integer"
                      },
                      "baseline_value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "baseline_status": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "final",
                          "provisional",
                          "estimated",
                          "missing",
                          "unknown",
                          null
                        ]
                      },
                      "target_year": {
                        "type": "integer"
                      },
                      "target_value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "required_change_pct": {
                        "type": "number"
                      },
                      "compare_year": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "compare_value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "compare_status": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "final",
                          "provisional",
                          "estimated",
                          "missing",
                          "unknown",
                          null
                        ]
                      },
                      "deadline_passed": {
                        "type": "boolean"
                      },
                      "change_pct": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "share_of_required_reduction": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "above_target_value": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "reference": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "period",
                        "value",
                        "status"
                      ],
                      "properties": {
                        "period": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "value": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "status": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "enum": [
                            "final",
                            "provisional",
                            "estimated",
                            "missing",
                            "unknown",
                            null
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
