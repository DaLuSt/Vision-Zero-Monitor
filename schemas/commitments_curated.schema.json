{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commitments_curated.schema.json",
  "title": "Curated policy commitments (input, reviewed by hand)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_at",
    "review_note",
    "commitments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_note": {
      "type": "string"
    },
    "commitments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "issuer",
          "level",
          "scope",
          "form",
          "nature",
          "date",
          "sources",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "issuer": {
            "type": "string",
            "minLength": 3
          },
          "level": {
            "enum": [
              "eu",
              "global",
              "national"
            ]
          },
          "scope": {
            "type": "string"
          },
          "form": {
            "enum": [
              "commission_policy",
              "council_conclusions",
              "ministerial_declaration",
              "un_resolution",
              "national_strategy"
            ]
          },
          "nature": {
            "type": "string",
            "minLength": 20
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "title",
                "reference",
                "publisher",
                "date",
                "url",
                "location",
                "quote"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "primary",
                    "first_set_out",
                    "reaffirmed"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 5
                },
                "reference": {
                  "type": "string",
                  "minLength": 3
                },
                "publisher": {
                  "type": "string",
                  "minLength": 3
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "location": {
                  "type": "string",
                  "minLength": 3
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 700
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2}$",
                  "description": "ISO 639-1 language of the quote; absent means English."
                },
                "translation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "text",
                    "kind"
                  ],
                  "description": "English translation of a quote in another language. 'official': published by the issuer (verified like the quote); 'own': made for this site and labelled as such.",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 20,
                      "maxLength": 900
                    },
                    "kind": {
                      "enum": [
                        "official",
                        "own"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 5
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "location": {
                      "type": "string",
                      "minLength": 3
                    }
                  }
                }
              }
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "indicator",
                "description",
                "reduction",
                "baseline_year",
                "target_year",
                "measure",
                "not_measured_reason",
                "scope_note",
                "monitoring_baselines"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "indicator": {
                  "enum": [
                    "road_deaths",
                    "serious_injuries"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 5
                },
                "reduction": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "baseline_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1990
                },
                "target_year": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2100
                },
                "measure": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "geo",
                        "indicator"
                      ],
                      "properties": {
                        "geo": {
                          "type": "string"
                        },
                        "indicator": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "not_measured_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "monitoring_baselines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "year",
                      "note",
                      "source"
                    ],
                    "properties": {
                      "year": {
                        "type": "integer",
                        "minimum": 1990
                      },
                      "note": {
                        "type": "string",
                        "minLength": 20
                      },
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "title",
                          "publisher",
                          "url"
                        ],
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "publisher": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https://"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "geo": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "Eurostat country code of a national commitment (absent for EU and global ones)."
          }
        }
      }
    }
  }
}
