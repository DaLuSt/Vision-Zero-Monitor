{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdowns.schema.json",
  "title": "Road-death breakdowns",
  "description": "Columnar series of road deaths by category; values[i] and statuses[i] refer to periods[i].",
  "type": "object",
  "required": ["schema_version", "generated_at", "periods", "dimensions", "series"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "periods": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\d{4}$"}},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "unit", "source_id", "source_url", "source_published_at", "retrieved_at", "categories", "eu_members_reporting"],
        "properties": {
          "id": {"enum": ["road_user", "vehicle", "age", "sex", "road_type"]},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "unit": {"const": "persons"},
          "source_id": {"type": "string"},
          "source_url": {"type": "string", "pattern": "^https://"},
          "source_published_at": {"type": ["string", "null"], "format": "date-time"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "ordinal": {"const": true, "description": "Categories have a natural order (age bands); charts keep it instead of sorting by size."},
          "eu_members_reporting": {
            "description": "Per period: number of Member States with a complete breakdown. EU values are comparable only at 27.",
            "type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 27}
          },
          "categories": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "description", "source_categories"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                "label": {"type": "string"},
                "description": {"type": "string"},
                "source_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geo", "dimension", "category", "values", "statuses"],
        "properties": {
          "geo": {"type": "string", "pattern": "^(EU27_2020|[A-Z]{2})$"},
          "dimension": {"enum": ["road_user", "vehicle", "age", "sex", "road_type"]},
          "category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "values": {"type": "array", "items": {"type": ["integer", "null"], "minimum": 0}},
          "statuses": {"type": "array", "items": {"enum": ["final", "provisional", "estimated", "missing", "unknown"]}}
        }
      }
    }
  }
}
