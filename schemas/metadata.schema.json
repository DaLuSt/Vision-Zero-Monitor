{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata.schema.json",
  "title": "Dataset metadata",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_hash", "frequency_notice", "sources", "targets", "coverage", "validation", "revisions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frequency_notice": {"type": "string"},
    "status_vocabulary": {"type": "object", "additionalProperties": {"type": "string"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "title", "role", "url", "source_published_at", "retrieved_at", "license"],
        "properties": {
          "id": {"type": "string"},
          "publisher": {"type": "string"},
          "title": {"type": "string"},
          "dataset": {"type": ["string", "null"]},
          "role": {"enum": ["primary", "breakdown", "denominator", "cross_check", "derived"]},
          "url": {"type": "string", "pattern": "^https://"},
          "api_url": {"type": ["string", "null"]},
          "metadata_url": {"type": ["string", "null"]},
          "source_published_at": {"type": ["string", "null"], "format": "date-time"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "latest_period_in_source": {"type": ["string", "null"]},
          "status_flag_labels": {"type": "object", "additionalProperties": {"type": "string"}},
          "license": {"type": "string"}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "geo", "indicator", "baseline_period", "target_period", "reduction_fraction", "baseline_value", "target_value", "note"],
        "properties": {
          "baseline_value": {"type": ["number", "null"]},
          "target_value": {"type": ["number", "null"]},
          "reduction_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["period", "member_states_reporting", "member_states_total", "missing"],
      "properties": {
        "period": {"type": ["string", "null"]},
        "member_states_reporting": {"type": "integer", "minimum": 0, "maximum": 27},
        "member_states_total": {"const": 27},
        "missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "validation": {
      "type": "object",
      "required": ["passed", "errors", "warnings"],
      "properties": {
        "passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "revisions": {
      "type": "object",
      "required": ["compared_with", "changed", "added", "removed"],
      "properties": {
        "compared_with": {"type": ["string", "null"]},
        "changed": {"type": "integer", "minimum": 0},
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "examples": {"type": "array"}
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["level", "code", "message"],
      "properties": {
        "level": {"enum": ["error", "warning"]},
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
