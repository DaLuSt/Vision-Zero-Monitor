{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline_status.schema.json",
  "title": "Pipeline status",
  "type": "object",
  "required": ["schema_version", "last_attempt_at", "last_outcome", "last_success_at", "message"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "last_attempt_at": {"type": "string", "format": "date-time"},
    "last_outcome": {"enum": ["success", "unchanged", "failure"]},
    "last_success_at": {"type": ["string", "null"], "format": "date-time"},
    "message": {"type": "string", "maxLength": 2000},
    "run_url": {"type": ["string", "null"]}
  }
}
