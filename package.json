{
  "name": "vision-zero-monitor",
  "private": true,
  "version": "1.0.0",
  "description": "Vision Zero Monitor – open-source platform monitoring Europe's road safety progress, legislation, policy commitments, and progress towards Vision Zero",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
