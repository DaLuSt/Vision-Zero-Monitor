PREFIX cdm: <http://publications.europa.eu/ontology/cdm#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?celex ?direction ?relation ?other (SAMPLE(?ort) AS ?other_type)
       (SAMPLE(?odate) AS ?other_date) (SAMPLE(?osent) AS ?other_dispatch) (SAMPLE(?otitle) AS ?other_title)
WHERE {
  VALUES ?celex { "31977L0649"^^xsd:string "31979L0795"^^xsd:string "31981D0790"^^xsd:string "31981L0643"^^xsd:string "31982L0890"^^xsd:string "31988L0366"^^xsd:string "31989L0684"^^xsd:string "31991L0671"^^xsd:string "31992L0006"^^xsd:string "31993D0172"^^xsd:string "31993D0173"^^xsd:string "31993D0704"^^xsd:string "31993L0095"^^xsd:string "31994D0242"^^xsd:string "31994D0243"^^xsd:string "31994D0244"^^xsd:string "31994D0245"^^xsd:string "31994D0247"^^xsd:string "31994D0694"^^xsd:string "31994L0023"^^xsd:string "31996D0012"^^xsd:string "31996L0037"^^xsd:string "31996L0038"^^xsd:string "31996L0079"^^xsd:string "31997L0027"^^xsd:string "31997L0039"^^xsd:string "31999L0007"^^xsd:string "31999L0023"^^xsd:string "31999L0024"^^xsd:string "31999L0098"^^xsd:string "32000L0007"^^xsd:string "32000L0056"^^xsd:string "32001H0115"^^xsd:string "32001Y0214(01)"^^xsd:string "32002L0015"^^xsd:string "32002L0085"^^xsd:string "32003L0019"^^xsd:string "32003L0020"^^xsd:string "32003L0102"^^xsd:string "32004D0090"^^xsd:string "32004H0345"^^xsd:string "32004L0054"^^xsd:string "32004R0432"^^xsd:string "32005D0050"^^xsd:string "32005L0049"^^xsd:string "32005L0066"^^xsd:string "32006D0368"^^xsd:string "32006L0126"^^xsd:string "32006R0561"^^xsd:string "32007H0078"^^xsd:string "32007L0038"^^xsd:string "32008D0671"^^xsd:string "32008H0653"^^xsd:string "32008L0065"^^xsd:string "32008L0096"^^xsd:string "32009D0159"^^xsd:string "32009L0005"^^xsd:string "32009R0078"^^xsd:string "32009R0631"^^xsd:string "32010L0040"^^xsd:string "32011H0750"^^xsd:string "32011L0082"^^xsd:string "32011R0228"^^xsd:string "32011R0459"^^xsd:string "32011R1214"^^xsd:string "32012D0143"^^xsd:string "32013R0305"^^xsd:string "32013R0886"^^xsd:string "32014D0585"^^xsd:string "32014L0045"^^xsd:string "32014L0046"^^xsd:string "32014L0047"^^xsd:string "32014L0085"^^xsd:string "32014R0165"^^xsd:string "32015D2088"^^xsd:string "32015L0413"^^xsd:string "32015R0758"^^xsd:string "32016D0209"^^xsd:string "32016R0068"^^xsd:string "32016R0130"^^xsd:string "32016R0403"^^xsd:string "32016R1004"^^xsd:string "32016R1788"^^xsd:string "32017D1013"^^xsd:string "32017D2077"^^xsd:string "32017D2380"^^xsd:string "32017R0548"^^xsd:string "32017R1503"^^xsd:string "32017R2205"^^xsd:string "32018D1926"^^xsd:string "32018L0645"^^xsd:string "32018R0828"^^xsd:string "32018R0829"^^xsd:string "32018R0830"^^xsd:string "32018R0858"^^xsd:string "32019D0984"^^xsd:string "32019L1936"^^xsd:string "32019R0543"^^xsd:string "32019R0621"^^xsd:string "32019R2144"^^xsd:string "32020D0848"^^xsd:string "32020D1637"^^xsd:string "32020R1054"^^xsd:string "32021D0366"^^xsd:string "32021D0395"^^xsd:string "32021D0925"^^xsd:string "32021D1981"^^xsd:string "32021L1716"^^xsd:string "32021L1717"^^xsd:string "32021R0535"^^xsd:string "32021R0646"^^xsd:string "32021R1243"^^xsd:string "32021R1244"^^xsd:string "32021R1341"^^xsd:string "32021R1445"^^xsd:string "32021R1958"^^xsd:string "32022D2200"^^xsd:string "32022D2357"^^xsd:string "32022L2561"^^xsd:string "32022R0545"^^xsd:string "32022R0670"^^xsd:string "32022R0694"^^xsd:string "32022R0695"^^xsd:string "32022R1012"^^xsd:string "32022R1209"^^xsd:string "32022R1280"^^xsd:string "32022R1398"^^xsd:string "32022R2236"^^xsd:string "32023D0069"^^xsd:string "32023D0983"^^xsd:string "32023H0688"^^xsd:string "32023L2661"^^xsd:string "32023R1675"^^xsd:string "32023R2590"^^xsd:string "32024D06798"^^xsd:string "32024D0784"^^xsd:string "32024D1253"^^xsd:string "32024D1775"^^xsd:string "32024D2868"^^xsd:string "32024L0846"^^xsd:string "32024L3237"^^xsd:string "32024R0883"^^xsd:string "32024R1084"^^xsd:string "32024R1180"^^xsd:string "32024R1258"^^xsd:string "32024R1721"^^xsd:string "32024R2220"^^xsd:string "32025D0433"^^xsd:string "32025D1115"^^xsd:string "32025D1273"^^xsd:string "32025D2362"^^xsd:string "32025L2205"^^xsd:string "32025L2206"^^xsd:string "32025R0014"^^xsd:string "32025R1117"^^xsd:string "32025R1122"^^xsd:string "32025R1871"^^xsd:string "32026D0563"^^xsd:string "32026D0861"^^xsd:string "32026D0907"^^xsd:string "32026D1411"^^xsd:string "32026R0699"^^xsd:string "32026R1188"^^xsd:string "32026R1554"^^xsd:string "32026R1753"^^xsd:string "32026R2266"^^xsd:string }
  VALUES ?p { cdm:resource_legal_amends_resource_legal cdm:resource_legal_repeals_resource_legal cdm:resource_legal_replaces_resource_legal cdm:resource_legal_adopts_resource_legal cdm:resource_legal_proposes_to_amend_resource_legal }
  ?w cdm:resource_legal_id_celex ?celex .
  { ?w ?p ?o . BIND("out" AS ?direction) } UNION { ?o ?p ?w . BIND("in" AS ?direction) }
  ?o cdm:resource_legal_id_celex ?other .
  FILTER(!REGEX(STR(?other), "R\\([0-9]+\\)$"))
  BIND(STRBEFORE(STRAFTER(STR(?p), "resource_legal_"), "_resource_legal") AS ?relation)
  OPTIONAL { ?o cdm:work_has_resource-type ?ortu . BIND(STRAFTER(STR(?ortu), "resource-type/") AS ?ort) }
  OPTIONAL { ?o cdm:work_date_document ?odate }
  OPTIONAL { ?o cdm:resource_legal_date_dispatch ?osent }
  OPTIONAL { ?oe cdm:expression_belongs_to_work ?o ; cdm:expression_uses_language <http://publications.europa.eu/resource/authority/language/ENG> ; cdm:expression_title ?otitle }
} GROUP BY ?celex ?direction ?relation ?other